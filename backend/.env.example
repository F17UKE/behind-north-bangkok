# Database: use DATABASE_URL or the individual DB_* fields below
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=behind_north_bangkok
# DATABASE_URL=postgres://user:password@host:5432/database

PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# Required for real menu, store, and payment slip image uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=behind-north-bangkok

# Google / LINE login only works after OAuth credentials are configured
GOOGLE_CLIENT_ID=
LINE_CLIENT_ID=

# PromptPay QR creation works when a merchant has a real promptpay_id.
# Slip verification provider is not integrated yet; uploads cannot mark orders as paid.
